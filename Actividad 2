Create Table Compradores (
    Nombre VARCHAR(100) NOT NULL,
    'Cantidad de Compras' INT(100) NOT NULL,
    'ID Comprador' INT(100) NOT NULL
   );
  
  Create Table Ordenes (
    'Producto(s)' VARCHAR(100) NOT NULL,
    Cantidad INT(100) NOT NULL,
    'Precio Actual' INT(100) NOT NULL,
    'Fecha en que se ordeno' VARCHAR(100) NOT NULL,
    'ID Producto' INT(100) NOT NULL,
    'ID Comprador' INT(100) NOT NULL
   );

